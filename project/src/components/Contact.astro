    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="notion-block group flex items-center gap-4 bg-white/30 dark:bg-neutral-800/30 backdrop-blur-sm p-6 rounded-xl hover:scale-[1.02]">
