---
import SectionTitle from './SectionTitle.astro';
---

<section id="contact" class="py-6 animate-fade-in">
  <SectionTitle title="Contact" icon="📬" />
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href="mailto:mact200590@gmail.com" class="notion-block group flex items-center gap-4 bg-white/30 dark:bg-neutral-800/30 backdrop-blur-sm p-6 rounded-xl hover:scale-[1.02]">
      <div class="bg-primary-100 dark:bg-primary-900/50 p-4 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600 dark:text-primary-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
