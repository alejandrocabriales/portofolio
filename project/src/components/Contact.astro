      </div>
      <div>
        <h3 class="text-lg font-medium">Phone</h3>
        <p class="text-neutral-600 dark:text-neutral-400">+598 093304340</p>
      </div>
    </div>
    
    <div class="notion-block flex items-center gap-4 bg-white/30 dark:bg-neutral-800/30 backdrop-blur-sm p-6 rounded-xl hover:scale-[1.02]">
      <div class="bg-primary-100 dark:bg-primary-900/50 p-4 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600 dark:text-primary-400">
