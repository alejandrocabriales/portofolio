      <div>
        <h3 class="text-lg font-medium group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">GitHub</h3>
        <p class="text-neutral-600 dark:text-neutral-400">github.com/alejandrocabriales</p>
