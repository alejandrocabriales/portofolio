---
import SectionTitle from './SectionTitle.astro';
import ExperienceItem from './ExperienceItem.astro';

const experiences = [
  {
    company: "DSpot",
    position: "Frontend Engineer",
    period: "Dec 2021 – Present",
    description: "Development of high-performance web applications with Next.js, SWR, Material UI and styled-components, optimizing user experience and accessibility.",
    technologies: ["Next.js", "React", "SWR", "Material UI", "styled-components"]
  },
  {
    company: "Fulltime",
    position: "Frontend Developer",
    period: "Nov 2019 – Sept 2021",
    description: "Creation of mobile applications in React Native, development of GraphQL APIs with Node.js and reusable components with React Hook Form.",
    technologies: ["React Native", "GraphQL", "Node.js", "React Hook Form"]
  },
  {
    company: "E-planning",
    position: "JavaScript Developer",
    period: "Aug 2018 – Nov 2019",
    description: "Development of advertising components in JavaScript, implementation of Header Bidding and technical support.",
    technologies: ["JavaScript", "Header Bidding", "Technical Support"]
  }
];
---

<section id="experience" class="py-6 animate-fade-in">
  <SectionTitle title="Experience" icon="💼" />
  
  <div class="space-y-6">
    {experiences.map((exp) => (
      <ExperienceItem 
        company={exp.company}
        position={exp.position}
        period={exp.period}
        description={exp.description}
        technologies={exp.technologies}
      />
    ))}
  </div>
</section>