---
interface Props {
  company: string;
  position: string;
  period: string;
  description: string;
  technologies: string[];
}

const { company, position, period, description, technologies } = Astro.props;
---

<div class="notion-block group transition-all duration-300 bg-white/30 dark:bg-neutral-800/30 backdrop-blur-sm p-6 rounded-xl">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-3">
    <div>
      <h3 class="text-xl font-medium gradient-text">{position}</h3>
      <p class="text-primary-600 dark:text-primary-400 font-medium">{company}</p>
    </div>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 sm:mt-0">{period}</p>
  </div>
  
  <p class="text-neutral-700 dark:text-neutral-300 mb-4">{description}</p>
  
  <div class="flex flex-wrap gap-2">
    {technologies.map((tech) => (
      <span class="px-3 py-1.5 bg-primary-100/50 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 rounded-full text-xs font-medium hover:scale-105 transition-transform cursor-default">
        {tech}
      </span>
    ))}
  </div>
</div>