---
import SectionTitle from './SectionTitle.astro';
---

<section id="education" class="py-6 animate-fade-in">
  <SectionTitle title="Education" icon="🎓" />
  
  <div class="notion-block">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-1">
      <h3 class="text-lg font-medium">Bachelor of Computer Science</h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 sm:mt-0">2008 - 2013</p>
    </div>
    <p class="text-primary-600 dark:text-primary-400">Universidad Central "Marta Abreu" de Las Villas, Cuba</p>
  </div>
  
  <div class="mt-6">
    <h3 class="text-lg font-medium mb-2">Languages</h3>
    <div class="flex flex-col gap-3">
      <div class="flex justify-between items-center">
        <span class="font-medium">Spanish</span>
        <span class="text-sm text-neutral-600 dark:text-neutral-400">Native</span>
      </div>
      <div class="flex justify-between items-center">
        <span class="font-medium">English</span>
        <span class="text-sm text-neutral-600 dark:text-neutral-400">Professional Competence</span>
      </div>
    </div>
  </div>
</section>