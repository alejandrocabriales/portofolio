---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/layout/Shell.astro';
import Masthead from '@/components/sections/Masthead.astro';
import ExperienceRow from '@/components/sections/ExperienceRow.astro';






import { SITE, SOCIALS, AVAILABILITY } from '@/config/site';
import { EXPERIENCE, EDUCATION, LANGUAGES } from '@/data/experience';
import { PROJECTS } from '@/data/projects';
import { STACK } from '@/data/stack';

import { formatRange, formatDate } from '@/lib/format';
import { getIndexedPosts, postPath, readingTime } from '@/lib/posts';
import { canonicalUrl } from '@/lib/seo';
import { PERSON_ID, projectListNode } from '@/lib/schema';

// Evidence decides weight: projects with a measured figure get a spec sheet,
// the rest are listed as rows beneath them.



/**
 * The index is a `ProfilePage` whose `mainEntity` is the Person — the schema.org
 * type Google documents for "a page about one individual". On a portfolio that
 * is not a technicality: it is the difference between the site reading as a
 * collection of documents and reading as one person's profile.
 */
const canonical = canonicalUrl(Astro.url);

/**
 * The writing is the other half of the evidence: case studies show outcomes,
 * posts show how the decisions were made. Featured-first, capped at three so
 * the section stays a pointer to /blog/ rather than a second blog index.
 */
const posts = (await getIndexedPosts()).slice(0, 3);
---
<Layout title={`${SITE.name} — ${SITE.role}`} description={`${SITE.role}, ${SITE.yearsExperience} years shipping production React, Next.js and Node. Case studies with measured outcomes. ${SITE.location.city}, ${SITE.location.country}.`} ogType="profile" pageType="ProfilePage" mainEntityId={PERSON_ID} schema={[projectListNode(canonical, PROJECTS)]}>
<Shell><main id="main">
  <Masthead />
  <section class="chapter" id="experience" aria-labelledby="experience-heading">
    <div class="chapter__head"><h2 id="experience-heading">Experience</h2><p>A selection of roles and measurable outcomes.</p><span class="chapter__number" aria-hidden="true">01</span></div>
    {EXPERIENCE.map(role => <ExperienceRow role={role} meta={formatRange(role.start, role.end)} />)}
  </section>
  <section class="chapter" id="stack" aria-labelledby="stack-heading">
    <div class="chapter__head"><h2 id="stack-heading">Stack</h2><p>The tools I build with.</p><span class="chapter__number" aria-hidden="true">02</span></div>
    <div class="stack">{STACK.map(group => <div class="stack__group"><h3>{group.label}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
    <details class="training"><summary>Education & languages</summary><p>{EDUCATION.degree} · {EDUCATION.institution} · {EDUCATION.start}–{EDUCATION.end}</p><p>{LANGUAGES.map(language => `${language.name}: ${language.level}`).join(' · ')}</p></details>
  </section>
  <section class="chapter" id="writing" aria-labelledby="writing-heading">
    <div class="chapter__head"><h2 id="writing-heading">Writing</h2><p>Notes on what I build and what I learn.</p><a class="chapter__link" href="/blog/">All writing <span aria-hidden="true">&rarr;</span></a><span class="chapter__number" aria-hidden="true">03</span></div>
    <div class="posts">{posts.map(post => <a class="post" href={postPath(post)}><span class="post__meta">{formatDate(post.data.published)} · {readingTime(post)} min read</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="post__read">Read article <span aria-hidden="true">&rarr;</span></span></a>)}</div>
  </section>
  <section class="chapter" id="work" aria-labelledby="work-heading">
    <div class="chapter__head"><h2 id="work-heading">Selected work</h2><p>Production systems, with the decisions behind them.</p><span class="chapter__number" aria-hidden="true">04</span></div>
    <div class="projects">{PROJECTS.map(project => <a class="project" href={`/work/${project.slug}/`}><div><h3>{project.name}</h3><p>{project.summary}</p></div><span class="project__year">{project.year}<span aria-hidden="true"> &nearr;</span></span></a>)}</div>
  </section>
  <section class="contact chapter" id="contact" aria-labelledby="contact-heading">
    <div><h2 id="contact-heading">Let’s talk</h2><p>{AVAILABILITY.open && <>{AVAILABILITY.label}.<br /></>}Remote, from {SITE.location.city}, {SITE.location.country}.</p></div>
    <div class="contact__links"><a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SOCIALS.linkedin && <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}{SOCIALS.github && <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a>}</div>
  </section>
</main></Shell>
</Layout>
<style>
.chapter { position:relative; isolation:isolate; padding-block:var(--space-xl); scroll-margin-top:var(--space-lg); }
.chapter__head { position:relative; padding-block:var(--space-sm) var(--space-lg); }
h2 { display:inline-block; font-size:1.75rem; line-height:1.25; padding:.1rem 1.1rem .25rem; background:var(--orange-fill); border-radius:var(--wobble-pill); transform:rotate(-1.5deg); }
.chapter:nth-of-type(even) h2 { transform:rotate(1.2deg); }
.chapter__head > p { margin-top:var(--space-sm); color:var(--color-muted); font-size:.9375rem; max-width:75%; }
.chapter__number { position:absolute; right:0; top:0; font-family:var(--font-hand); color:var(--color-faint); font-size:1.25rem; font-weight:400; line-height:1; pointer-events:none; }
.chapter__number::before { content:'#'; }
.chapter__link { display:inline-block; margin-top:var(--space-sm); color:var(--color-ink); font-family:var(--font-hand); font-size:1.0625rem; font-weight:700; text-decoration:underline wavy var(--color-accent); text-underline-offset:5px; white-space:nowrap; }
.chapter__link:hover { color:var(--color-accent-text); }
.stack { display:grid; gap:var(--space-md); }
.stack__group { display:grid; grid-template-columns:9rem minmax(0,1fr); gap:var(--space-sm); align-items:baseline; }
.stack__group h3 { font-family:var(--font-hand); font-size:1.125rem; font-weight:700; color:var(--color-ink); }
.stack ul { display:flex; flex-wrap:wrap; gap:.5rem; padding:0; list-style:none; }
.stack li { background:var(--mint-soft); border:1.5px solid var(--color-ink); border-radius:var(--wobble-pill); font: .75rem/1.5 var(--font-mono); padding:.2rem .65rem; }
.training { margin-top:var(--space-lg); font-size:.875rem; color:var(--color-muted); }
.training summary { cursor:pointer; padding-block:.5rem; font-family:var(--font-hand); font-size:1.0625rem; font-weight:700; color:var(--color-ink); }
.training p { margin-top:.5rem; max-width:70ch; }
.posts { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr)); gap:var(--space-lg); }
.post { display:flex; flex-direction:column; align-items:flex-start; padding:var(--space-md) var(--space-md) var(--space-lg); background:var(--card); border:var(--sketch-w) solid var(--color-ink); border-radius:var(--wobble); color:var(--color-ink); text-decoration:none; transform:rotate(-.6deg); transition:transform var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out); }
.post:nth-child(even) { border-radius:var(--wobble-2); transform:rotate(.7deg); }
.post:hover { transform:rotate(0) translateY(-3px); box-shadow:4px 5px 0 var(--mint); }
.post__meta { font: .6875rem/1.6 var(--font-mono); color:var(--color-faint); }
.post h3 { font-size:1.45rem; line-height:1.2; margin-top:var(--space-sm); }
.post p { font-size:.875rem; line-height:1.6; color:var(--color-muted); margin-top:var(--space-xs); max-width:65ch; }
.post__read { font-family:var(--font-hand); font-weight:700; font-size:1rem; padding-top:var(--space-md); margin-top:auto; text-decoration:underline wavy var(--color-accent); text-underline-offset:5px; }
.projects { display:grid; gap:var(--space-md); }
.project { display:flex; gap:var(--space-lg); justify-content:space-between; padding:var(--space-md) var(--space-lg); border:var(--sketch-w) solid var(--color-ink); border-radius:var(--wobble-2); background:var(--card); text-decoration:none; color:var(--color-ink); transition:box-shadow var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out); }
.project:nth-child(even) { border-radius:var(--wobble); }
.project:hover { box-shadow:4px 5px 0 var(--orange-fill); transform:translateY(-2px); }
.project h3 { font-size:1.4rem; line-height:1.25; }
.project p { max-width:65ch; margin-top:.4rem; font-size:.875rem; color:var(--color-muted); }
.project__year { flex:none; font-family:var(--font-hand); font-size:1.0625rem; font-weight:700; color:var(--color-ink); padding-top:.2rem; white-space:nowrap; }
.contact { display:flex; justify-content:space-between; align-items:center; gap:var(--space-lg); margin-block:var(--space-xl) var(--space-2xl); padding:var(--space-lg) var(--space-xl); border:var(--sketch-w) solid var(--color-ink); border-radius:var(--wobble); background:var(--mint-soft); transform:rotate(-.4deg); }
.contact h2 { font-size:1.75rem; }
.contact p { font-size:.9375rem; line-height:1.6; color:var(--color-muted); margin-top:var(--space-sm); }
.contact__links { display:flex; flex-direction:column; align-items:flex-start; font-family:var(--font-hand); font-size:1.125rem; font-weight:700; gap:.35rem; }
.contact__links a { color:var(--color-ink); text-decoration:underline wavy var(--color-accent); text-underline-offset:5px; overflow-wrap:anywhere; }
.contact__links a:hover { color:var(--color-accent-text); }
@media(max-width:40rem) { .chapter { padding-block:var(--space-lg); } .stack__group { grid-template-columns:minmax(0,1fr); gap:.4rem; } .contact { flex-direction:column; align-items:flex-start; padding:var(--space-md); } .project { gap:var(--space-sm); padding:var(--space-md); flex-direction:column; } .post, .post:nth-child(even) { transform:none; } }
@media (prefers-reduced-motion: reduce) { .post:hover, .project:hover { transform:none; } }
</style>
