---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/layout/Shell.astro';
import Masthead from '@/components/sections/Masthead.astro';
import ExperienceRow from '@/components/sections/ExperienceRow.astro';






import { SITE, SOCIALS, AVAILABILITY } from '@/config/site';
import { EXPERIENCE, EDUCATION, LANGUAGES } from '@/data/experience';
import { PROJECTS } from '@/data/projects';
import { STACK } from '@/data/stack';

import { formatRange, formatDate } from '@/lib/format';
import { getIndexedPosts, postPath, readingTime } from '@/lib/posts';
import { canonicalUrl } from '@/lib/seo';
import { PERSON_ID, projectListNode } from '@/lib/schema';

// Evidence decides weight: projects with a measured figure get a spec sheet,
// the rest are listed as rows beneath them.



/**
 * The index is a `ProfilePage` whose `mainEntity` is the Person — the schema.org
 * type Google documents for "a page about one individual". On a portfolio that
 * is not a technicality: it is the difference between the site reading as a
 * collection of documents and reading as one person's profile.
 */
const canonical = canonicalUrl(Astro.url);

/**
 * The writing is the other half of the evidence: case studies show outcomes,
 * posts show how the decisions were made. Featured-first, capped at three so
 * the section stays a pointer to /blog/ rather than a second blog index.
 */
const posts = (await getIndexedPosts()).slice(0, 3);
---
<Layout title={`${SITE.name} — ${SITE.role}`} description={`${SITE.role}, ${SITE.yearsExperience} years shipping production React, Next.js and Node. Case studies with measured outcomes. ${SITE.location.city}, ${SITE.location.country}.`} ogType="profile" pageType="ProfilePage" mainEntityId={PERSON_ID} schema={[projectListNode(canonical, PROJECTS)]}>
<Shell><main id="main">
  <Masthead />
  <section class="chapter" id="experience" aria-labelledby="experience-heading">
    <div class="chapter__head"><h2 id="experience-heading">Experience</h2><p>A selection of roles and measurable outcomes.</p><span class="chapter__number" aria-hidden="true">01</span></div>
    {EXPERIENCE.map(role => <ExperienceRow role={role} meta={formatRange(role.start, role.end)} />)}
  </section>
  <section class="chapter" id="stack" aria-labelledby="stack-heading">
    <div class="chapter__head"><h2 id="stack-heading">Stack</h2><p>The tools I build with.</p><span class="chapter__number" aria-hidden="true">02</span></div>
    <div class="stack">{STACK.map(group => <div class="stack__group"><h3>{group.label}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
    <details class="training"><summary>Education & languages</summary><p>{EDUCATION.degree} · {EDUCATION.institution} · {EDUCATION.start}–{EDUCATION.end}</p><p>{LANGUAGES.map(language => `${language.name}: ${language.level}`).join(' · ')}</p></details>
  </section>
  <section class="chapter" id="writing" aria-labelledby="writing-heading">
    <div class="chapter__head"><h2 id="writing-heading">Writing</h2><p>Notes on what I build and what I learn.</p><a class="chapter__link" href="/blog/">All writing <span aria-hidden="true">&rarr;</span></a><span class="chapter__number" aria-hidden="true">03</span></div>
    <div class="posts">{posts.map(post => <a class="post" href={postPath(post)}><span class="post__meta">{formatDate(post.data.published)} · {readingTime(post)} min read</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="post__read">Read article <span aria-hidden="true">&rarr;</span></span></a>)}</div>
  </section>
  <section class="chapter" id="work" aria-labelledby="work-heading">
    <div class="chapter__head"><h2 id="work-heading">Selected work</h2><p>Production systems, with the decisions behind them.</p><span class="chapter__number" aria-hidden="true">04</span></div>
    <div class="projects">{PROJECTS.map(project => <a class="project" href={`/work/${project.slug}/`}><div><h3>{project.name}</h3><p>{project.summary}</p></div><span class="project__year">{project.year}<span aria-hidden="true"> &nearr;</span></span></a>)}</div>
  </section>
  <section class="contact chapter" id="contact" aria-labelledby="contact-heading">
    <div><h2 id="contact-heading">Let’s talk</h2><p>{AVAILABILITY.open && <>{AVAILABILITY.label}.<br /></>}Remote, from {SITE.location.city}, {SITE.location.country}.</p></div>
    <div class="contact__links"><a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SOCIALS.linkedin && <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}{SOCIALS.github && <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a>}</div>
  </section>
</main></Shell>
</Layout>
<style>
.chapter { position:relative; isolation:isolate; padding-block:var(--space-xl); border-top:1px solid var(--color-rule); scroll-margin-top:var(--space-lg); }
.chapter__head { position:relative; padding-block:var(--space-sm) var(--space-md); }
h2 { font-size:1.8rem; line-height:1.2; }
.chapter__head > p { margin-top:.4rem; color:var(--color-muted); font-size:.875rem; max-width:75%; }
.chapter__number { position:absolute; right:0; top:-2.5rem; font-family:var(--font-display); color:var(--number); font-size:8rem; font-weight:700; line-height:1; pointer-events:none; z-index:-1; }
.chapter__link { display:inline-block; margin-top:var(--space-sm); color:var(--color-accent-text); font-size:.8125rem; text-underline-offset:4px; white-space:nowrap; }
.stack { display:grid; gap:var(--space-sm); }
.stack__group { display:grid; grid-template-columns:9rem minmax(0,1fr); gap:var(--space-sm); align-items:baseline; }
.stack__group h3 { font-family:var(--font-body); font-size:.75rem; font-weight:500; color:var(--color-faint); letter-spacing:0; }
.stack ul { display:flex; flex-wrap:wrap; gap:.35rem; padding:0; list-style:none; }
.stack li { background:var(--color-paper-2); font: .6875rem/1.5 var(--font-mono); padding:.25rem .5rem; }
.training { margin-top:var(--space-lg); font-size:.8125rem; color:var(--color-muted); }
.training summary { cursor:pointer; padding-block:.5rem; }
.training p { margin-top:.5rem; max-width:70ch; }
.posts { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr)); gap:var(--space-md); }
.post { display:flex; flex-direction:column; align-items:flex-start; padding:var(--space-md); background:var(--card); border:1px solid var(--color-rule); color:var(--color-ink); text-decoration:none; transition:border-color var(--dur-short) var(--ease-out); }
.post:hover { border-color:var(--color-accent); }
.post__meta { font: .6875rem/1.6 var(--font-mono); color:var(--color-faint); }
.post h3 { font-size:1.35rem; line-height:1.2; margin-top:var(--space-sm); }
.post p { font-size:.8125rem; line-height:1.6; color:var(--color-muted); margin-top:var(--space-xs); max-width:65ch; }
.post__read { color:var(--color-accent-text); font-size:.75rem; padding-top:var(--space-md); margin-top:auto; }
.project { display:flex; gap:var(--space-lg); justify-content:space-between; padding-block:var(--space-md); border-bottom:1px solid var(--color-rule); text-decoration:none; color:var(--color-ink); }
.project:last-child { border-bottom:0; }
.project h3 { font-size:1.25rem; line-height:1.3; }
.project:hover h3 { color:var(--color-accent-text); }
.project p { max-width:65ch; margin-top:.4rem; font-size:.8125rem; color:var(--color-muted); }
.project__year { flex:none; font: .6875rem/1.5 var(--font-mono); color:var(--color-faint); padding-top:.3rem; white-space:nowrap; }
.contact { display:flex; justify-content:space-between; gap:var(--space-lg); padding-block:var(--space-xl) var(--space-2xl); }
.contact h2 { font-size:1.5rem; }
.contact p { font-size:.8125rem; line-height:1.6; color:var(--color-muted); margin-top:var(--space-xs); }
.contact__links { display:flex; flex-direction:column; align-items:flex-start; font-size:.8125rem; gap:.3rem; }
.contact__links a { color:var(--color-accent-text); text-decoration:none; overflow-wrap:anywhere; }
.contact__links a:hover { text-decoration:underline; text-underline-offset:3px; }
@media(max-width:40rem) { .chapter { padding-block:var(--space-lg); } .chapter__number { font-size:6rem; top:-1.5rem; } .stack__group { grid-template-columns:minmax(0,1fr); gap:.4rem; } .contact { flex-direction:column; } .project { gap:var(--space-sm); } }
</style>
