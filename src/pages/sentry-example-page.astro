---
/**
 * Sentry smoke test.
 *
 * Button throws in the browser so you can confirm events actually reach the
 * Sentry project. Not linked from anywhere, and noindexed — delete once
 * verified.
 */
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/layout/Shell.astro';
---

<Layout title="Sentry check" description="Throws a test error to verify Sentry capture." noindex>
  <Shell>
    <main id="main" data-pagefind-ignore>
      <section class="check">
        <h1 class="check__title">Sentry check</h1>
        <p class="check__lede">Click the button, then look for a new issue in Sentry.</p>
        <button id="throw-error" type="button" class="check__btn">Throw test error</button>
      </section>
    </main>
  </Shell>
</Layout>

<script>
  document.getElementById('throw-error')?.addEventListener('click', () => {
    throw new Error('Sentry example frontend error');
  });
</script>

<style>
  .check {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .check__title {
    font-size: var(--text-display-s);
    letter-spacing: -0.03em;
  }

  .check__lede {
    margin-block-start: var(--space-md);
    max-inline-size: 52ch;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }

  .check__btn {
    margin-block-start: var(--space-lg);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-accent-text);
    color: var(--color-accent-text);
    background: none;
    cursor: pointer;
  }
</style>
