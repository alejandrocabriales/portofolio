---
/**
 * Sentry smoke test #2 — manual capture paths.
 *
 * example1 (/sentry-example-page) shows the automatic path: an uncaught
 * throw, grabbed by Sentry's global handler. This page shows the other two:
 * a handled error captured manually with tags/context, and an unhandled
 * promise rejection (a common gap — easy to forget these get caught too).
 * Not linked from anywhere, noindexed — delete once verified.
 */
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/layout/Shell.astro';
---

<Layout title="Sentry check 2" description="Manual capture, breadcrumbs and promise rejections." noindex>
  <Shell>
    <main id="main" data-pagefind-ignore>
      <section class="check">
        <h1 class="check__title">Sentry check — manual capture</h1>
        <p class="check__lede">
          Each button exercises a different capture path. Click all three, then compare how they
          show up in Sentry's issue list.
        </p>

        <div class="check__row">
          <button id="manual-capture" type="button" class="check__btn">
            Capture handled error (with context)
          </button>
          <p class="check__hint">try/catch → breadcrumb + tags → Sentry.captureException</p>
        </div>

        <div class="check__row">
          <button id="promise-rejection" type="button" class="check__btn">
            Trigger unhandled promise rejection
          </button>
          <p class="check__hint">async fn rejects, nothing catches it</p>
        </div>
      </section>
    </main>
  </Shell>
</Layout>

<script>
  import * as Sentry from '@sentry/astro';

  document.getElementById('manual-capture')?.addEventListener('click', () => {
    Sentry.addBreadcrumb({
      category: 'ui.click',
      message: 'User clicked "Capture handled error"',
      level: 'info',
    });

    try {
      throw new Error('Sentry example handled error (with context)');
    } catch (err) {
      Sentry.captureException(err, {
        tags: { demo: 'manual-capture' },
        extra: { note: 'Caught in a try/catch, sent manually with tags/extra.' },
      });
    }
  });

  document.getElementById('promise-rejection')?.addEventListener('click', () => {
    async function willReject() {
      throw new Error('Sentry example unhandled promise rejection');
    }
    willReject();
  });
</script>

<style>
  .check {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .check__title {
    font-size: var(--text-display-s);
    letter-spacing: -0.03em;
  }

  .check__lede {
    margin-block-start: var(--space-md);
    max-inline-size: 52ch;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }

  .check__row {
    margin-block-start: var(--space-lg);
  }

  .check__btn {
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-accent-text);
    color: var(--color-accent-text);
    background: none;
    cursor: pointer;
  }

  .check__hint {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
