---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import PostLayout from '@/layouts/PostLayout.astro';
import { getPublishedPosts, type Post } from '@/lib/posts';

/**
 * One static page per published post. Drafts are absent from
 * `getPublishedPosts` at build time, so a draft has no route in production —
 * it can't be reached by guessing the URL either.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings}>
  <Content />
</PostLayout>
