---
import type { GetStaticPaths } from 'astro';

import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/layout/Shell.astro';
import IndexSection from '@/components/ui/IndexSection.astro';
import IndexRow from '@/components/ui/IndexRow.astro';

import { getPublishedPosts, postPath, readingTime, type Post } from '@/lib/posts';
import { formatDate } from '@/lib/format';
import { SITE } from '@/config/site';
import { canonicalUrl } from '@/lib/seo';
import { breadcrumbNode } from '@/lib/schema';

/** One archive page per tag that actually has posts — no empty archives. */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, Post[]>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      byTag.set(tag, [...(byTag.get(tag) ?? []), post]);
    }
  }

  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tag, posts: tagged },
  }));
};

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;

const canonical = canonicalUrl(Astro.url);
const crumbs = breadcrumbNode(canonical, [
  { name: 'Home', path: '/' },
  { name: 'Writing', path: '/blog/' },
  { name: `#${tag}` },
]);

/**
 * `noindex, follow` on tag archives.
 *
 * Every one of these pages is a filtered subset of `/blog/` — same titles, same
 * descriptions, no prose of its own. Indexed, they compete with the posts they
 * link to and dilute the site's crawl budget across near-duplicates. `follow`
 * keeps them doing the one job they are good at: passing crawlers through to
 * the posts. They stay out of the sitemap for the same reason.
 *
 * Flip this off if a tag ever grows its own written introduction.
 */
const titles = posts.map((post) => post.data.title).slice(0, 3).join(', ');
---

<Layout
  title={`#${tag} — Writing — ${SITE.shortName}`}
  description={`Every post tagged ${tag} by ${SITE.name}${titles ? `: ${titles}` : ''}.`}
  noindex
  pageType="CollectionPage"
  breadcrumbId={`${canonical}#breadcrumb`}
  schema={[crumbs]}
>
  <Shell>
    <main id="main">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/blog/">Writing</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">#{tag}</span>
      </nav>

      <!-- Every page needs exactly one h1, including the ones that opt out of
        the index: a screen reader announces the document's heading regardless
        of what `robots` says, and "#astro" is a better answer than silence. -->
      <h1 class="tag-title">#{tag}</h1>

      <IndexSection
        label={`${posts.length} post${posts.length === 1 ? '' : 's'} tagged ${tag}`}
        id="posts"
        action={{ label: 'All posts →', href: '/blog/' }}
      >
        {
          posts.map((post) => (
            <IndexRow
              title={post.data.title}
              subtitle={post.data.category}
              description={post.data.description}
              meta={`${formatDate(post.data.published)} · ${readingTime(post)} min`}
              href={postPath(post)}
            />
          ))
        }
      </IndexSection>
    </main>
  </Shell>
</Layout>

<style>
  .crumb {
    display: flex;
    gap: var(--space-2xs);
    padding-block-start: var(--space-2xl);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-faint);
  }
  .crumb a {
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .crumb a:hover {
    color: var(--color-accent-text);
  }

  .tag-title {
    padding-block: var(--space-md) var(--space-xs);
    font-size: var(--text-display-s);
    letter-spacing: -0.03em;
  }
</style>
