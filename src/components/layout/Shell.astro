---
/**
 * The page container: header, a shell-width column, footer.
 *
 * Wider than a reading column on purpose — the home page is a spec sheet laid
 * across the screen, and reading measures are set inside the blocks that need
 * them (prose, summaries), not by the shell. Deeproom bands break out of it with
 * the `.bleed` utility.
 *
 * The `<main>` landmark stays in the page so each route labels its own region.
 */
import Header from './Header.astro';
import Footer from './Footer.astro';
---

<Header />
<div class="shell">
  <slot />
</div>
<Footer />

<style>
  .shell {
    max-inline-size: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
