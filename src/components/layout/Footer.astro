---
import { SITE } from '@/config/site';
---
<footer><div><span>© {new Date().getFullYear()} {SITE.shortName}</span><a href="/rss.xml">RSS feed</a></div></footer>
<style>
footer { color:var(--color-faint); }
footer > div { max-width:var(--shell); margin:auto; padding:var(--space-md) var(--gutter); display:flex; justify-content:space-between; gap:var(--space-sm); border-top:1px solid var(--color-rule); font-size:.6875rem; }
a { color:inherit; text-underline-offset:3px; white-space:nowrap; }
</style>
