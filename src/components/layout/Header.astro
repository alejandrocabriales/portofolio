---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { SITE } from '@/config/site';
---
<header class="header"><nav aria-label="Primary"><a class="wordmark" href="/">{SITE.shortName}</a><div class="links"><a href="/#experience">Experience</a><a href="/blog/">Writing</a><a href="/#contact">Contact</a></div><ThemeToggle /></nav></header>
<style>
.header { background:var(--color-paper); }
nav { max-width:var(--shell); margin-inline:auto; padding:var(--space-md) var(--gutter); display:flex; align-items:center; gap:var(--space-sm); min-height:80px; }
.wordmark { font-family:var(--font-display); font-size:1.125rem; font-weight:700; color:var(--color-ink); text-decoration:none; white-space:nowrap; }
.links { display:flex; align-items:center; gap:var(--space-md); margin-left:auto; }
.links a { color:var(--color-muted); text-decoration:none; font-size:.8125rem; white-space:nowrap; padding-block:.75rem; }
.links a:hover { color:var(--color-accent-text); }
@media(max-width:40rem) { nav { flex-wrap:wrap; gap:0 var(--space-xs); padding-block:var(--space-sm); } .wordmark { margin-right:auto; } .links { order:3; width:100%; margin-left:0; justify-content:space-between; } }
</style>
