---
/**
 * Every `<head>` tag that exists for a machine rather than a human.
 *
 * Split out of `Layout.astro` because the list is long, order-insensitive and
 * almost entirely derived — keeping it inline made the layout read as if the
 * theme script and the Twitter card were decisions of the same weight.
 *
 * Deliberately not using an SEO integration package: the whole surface is ~40
 * static tags, and a dependency here would add a second source of truth for the
 * same values that `src/config/site.ts` already owns.
 */
import { SITE } from '@/config/site';
import { canonicalUrl, resolveOgImage, type SeoProps } from '@/lib/seo';

type Props = SeoProps;

const {
  title,
  description,
  image,
  imageAlt = SITE.ogImage.alt,
  ogType = 'website',
  noindex = false,
  markdownAlternate,
  article,
} = Astro.props;

const canonical = canonicalUrl(Astro.url);
const ogImage = resolveOgImage(image);

/**
 * `max-image-preview:large` is what lets Google show the social card in a
 * result instead of a thumbnail, and `max-snippet:-1` removes the snippet
 * length cap. Both are opt-in; the default is the smaller treatment.
 */
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
{
  /* Google's guidance: a `noindex` page should not also declare a canonical.
    The two instructions conflict — one says "drop this URL", the other says
    "this URL is the one to keep" — and which wins is not defined. */
  !noindex && <link rel="canonical" href={canonical} />
}
<meta name="robots" content={robots} />
<meta name="author" content={SITE.name} />

{/* Open Graph — read by LinkedIn, Slack, WhatsApp, Discord and Facebook. */}
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(SITE.ogImage.width)} />
<meta property="og:image:height" content={String(SITE.ogImage.height)} />
<meta property="og:image:alt" content={imageAlt} />

{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta
        property="article:modified_time"
        content={(article.modified ?? article.published).toISOString()}
      />
      <meta property="article:author" content={SITE.name} />
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

{/* `twitter:card` alone. X falls back to the `og:` properties for title,
  description and image, so duplicating them here would only add four tags that
  can drift out of sync with the four above. */}
<meta name="twitter:card" content="summary_large_image" />

{
  /* A markdown copy of the page, for agents that would otherwise have to parse
    HTML to read it. Cheap to serve from a content collection, and it removes
    any ambiguity about what the article actually says. */
  markdownAlternate && (
    <link rel="alternate" type="text/markdown" href={new URL(markdownAlternate, SITE.url).href} />
  )
}

{/* Feed discovery: browsers and readers look for exactly this rel/type pair. */}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — Writing`}
  href={new URL('/rss.xml', SITE.url).href}
/>

{/* Icons. The SVG serves modern browsers; the PNG exists for iOS, which
  ignores SVG favicons and would otherwise screenshot the page instead. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
