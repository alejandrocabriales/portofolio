---
interface Props {
  title: string;
  icon?: string;
}

const { title, icon } = Astro.props;
---

<div class="flex items-center gap-2 mb-4 mt-8 first:mt-0 border-b border-neutral-200 dark:border-neutral-700 pb-1">
  {icon && <span class="text-neutral-500 dark:text-neutral-400">{icon}</span>}
  <h2 class="text-xl font-semibold">{title}</h2>
</div>