---
import { SITE, AVAILABILITY } from '@/config/site';
---
<section class="masthead" aria-labelledby="masthead-title">
  <div class="masthead__copy">
    <h1 id="masthead-title">Systems that hold up in production.</h1>
    <p class="masthead__intro">{SITE.role}. {SITE.yearsExperience} years building web products and AI agents, and writing about what I learn along the way. Based in {SITE.location.city}, {SITE.location.country}.</p>
    <div class="masthead__actions">
      <a class="button button--primary" href="#experience">Explore my experience</a>
      <a class="button" href={`mailto:${SITE.email}`}>Get in touch</a>
    </div>
    {AVAILABILITY.open && <p class="masthead__status"><span aria-hidden="true"></span>{AVAILABILITY.label}</p>}
  </div>
  <div class="code-mark" aria-hidden="true"><div class="code-mark__back"></div><div class="code-mark__front"><svg viewBox="0 0 80 60" fill="none"><path d="m25 20-13 10 13 10m30-20 13 10-13 10M46 12 34 48" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div>
</section>
<style>
.masthead { display:grid; grid-template-columns:minmax(0, 1.5fr) minmax(0, 1fr); align-items:center; gap:var(--space-xl); padding-block:var(--space-4xl) var(--space-3xl); }
h1 { font-size:clamp(2.7rem, 4.9vw, 4.4rem); line-height:1.04; letter-spacing:-.025em; max-width:13ch; }
.masthead__intro { margin-top:var(--space-md); max-width:46ch; font-size:1rem; color:var(--color-muted); line-height:1.65; }
.masthead__actions { display:flex; flex-wrap:wrap; gap:var(--space-xs); margin-top:var(--space-lg); }
.button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding: .65rem 1rem; border:1px solid var(--color-rule); color:var(--color-ink); background:var(--color-paper); font-size:.8125rem; font-weight:600; text-decoration:none; white-space:nowrap; transition:background var(--dur-short) var(--ease-out); }
.button:hover { background:var(--color-paper-2); }
.button--primary { background:var(--color-accent); border-color:var(--color-accent); color:var(--color-paper); }
.button--primary:hover { background:var(--color-accent-text); }
.masthead__status { display:flex; align-items:center; gap:.5rem; margin-top:var(--space-md); color:var(--color-faint); font-size:.75rem; }
.masthead__status span { width:5px; height:5px; background:var(--color-accent); border-radius:50%; flex:none; }
.code-mark { position:relative; width:180px; height:180px; justify-self:center; }
.code-mark__front,.code-mark__back { position:absolute; inset:20px; border:1px solid var(--color-rule); border-radius:10px; }
.code-mark__front { display:grid; place-items:center; transform:rotate(7deg); border-color:var(--color-accent); background:var(--color-paper); color:var(--color-accent); }
.code-mark__front svg { width:75px; }
.code-mark__back { transform:rotate(-7deg) translate(-12px,12px); }
@media(max-width:40rem) { .masthead { grid-template-columns:minmax(0,1fr); padding-block:var(--space-2xl); gap:0; } h1 { font-size:clamp(2.7rem,10vw,3.8rem); max-width:15ch; } .code-mark { display:none; } }
</style>
