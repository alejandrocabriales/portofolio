---
/**
 * A measured project, filed as a print session.
 *
 * Only projects with a figure get a session card — evidence decides weight on
 * the page; the rest render as plain rows. The figure is printed: silver
 * tones on a white-bordered print, the card's loudest element. Below it, the
 * same three ruled stations on every card: Built, Shipped, Measured. A figure
 * whose impact is still being measured prints dashed and under-developed.
 *
 * The whole sheet links to the case study through a stretched `::after`; the
 * live-site or write-up link sits above that overlay as its own target.
 *
 * Hover takes the card into the deeproom — brown ground, amber type — the
 * way the contact sheet holds the prints. Not a lift or a shadow.
 */
import type { Project } from '@/data/projects';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="sheet">
  <div class="sheet__top">
    <h3 class="sheet__name">
      <a href={`/work/${project.slug}/`} class="sheet__link">{project.name}</a>
    </h3>
  </div>

  {
    project.figure && (
      <p class:list={['sheet__figure', { 'sheet__figure--developing': project.figure.developing }]}>
        <span class="sheet__value tabular">{project.figure.value}</span>
      </p>
    )
  }

  <p class="sheet__summary">{project.summary}</p>

  <!-- The same three stations for every project: what it was built with,
    where and when it shipped, what it measurably changed. -->
  <dl class="stations">
    <div class="stations__row">
      <dt>Built</dt>
      <dd>{project.stack.join(', ')}</dd>
    </div>
    <div class="stations__row">
      <dt>Shipped</dt>
      <dd>
        {project.context} · <time>{project.year}</time>
        {
          project.url && (
            <a class="sheet__external" href={project.url} target="_blank" rel="noopener noreferrer">
              Live site
              <Arrow kind="out" />
            </a>
          )
        }
        {
          !project.url && project.writeup && (
            <a class="sheet__external" href={project.writeup}>
              Write-up
              <Arrow kind="next" />
            </a>
          )
        }
      </dd>
    </div>
    {
      project.figure && (
        <div class="stations__row">
          <dt>Measured</dt>
          <dd>
            {project.figure.caption}
            {project.figure.developing && <span class="stations__developing">{project.figure.developing}</span>}
          </dd>
        </div>
      )
    }
  </dl>
</article>

<style>
  .sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    border: var(--rule-heavy) solid var(--color-ink);
    background-color: var(--color-paper);
    transition:
      background-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .sheet:hover {
    background-color: var(--color-field);
    border-color: var(--color-field);
    color: var(--color-on-field);
  }

  .sheet__top {
    padding-block-end: var(--space-sm);
    border-block-end: var(--rule-hair) solid currentColor;
  }

  .sheet__name {
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    font-weight: 800;
    font-stretch: var(--stretch-title);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .sheet__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretches the case-study link across the whole sheet. */
  .sheet__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .sheet__figure {
    margin-block-start: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* The print: white border, silver tones, the figure developed into it. */
  .sheet__value {
    display: block;
    padding: var(--space-md) var(--space-sm) var(--space-sm);
    border: 0.375rem solid var(--print-hi);
    background: radial-gradient(ellipse 120% 100% at 25% 15%, var(--print-hi), var(--print-lo) 90%);
    color: var(--print-ink);
  }

  .sheet__value {
    font-family: var(--font-display);
    font-stretch: var(--stretch-claim);
    font-size: clamp(4rem, 2.4rem + 4.4vw, 7.5rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.04em;
  }

  .sheet__figure--developing .sheet__value {
    border-style: dashed;
    background: var(--print-lo);
  }

  .sheet__summary {
    margin-block-start: var(--space-md);
    max-inline-size: 52ch;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .stations {
    margin: auto 0 0;
    padding-block-start: var(--space-md);
  }

  .stations__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: baseline;
    padding-block: var(--space-2xs);
    border-block-start: var(--rule-hair) solid currentColor;
  }

  .stations__row dt {
    font-family: var(--font-mono);
    font-stretch: var(--stretch-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .stations__row dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .stations__developing {
    display: block;
    margin-block-start: var(--space-3xs);
    font-family: var(--font-mono);
    font-stretch: var(--stretch-mono);
    font-size: 0.6875rem;
    color: var(--color-faint);
  }

  .sheet__external {
    position: relative;
    z-index: 1;
    margin-inline-start: var(--space-xs);
    display: inline-flex;
    font-family: var(--font-mono);
    font-stretch: var(--stretch-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    align-items: center;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    white-space: nowrap;
  }

  /* In the deeproom every secondary tone goes to the dimmed amber. */
  .sheet:hover :is(.sheet__summary, .stations__row dt, .stations__developing) {
    color: var(--color-on-field-muted);
  }
  .sheet :focus-visible {
    outline-color: var(--color-ink);
  }
</style>
