---
import type { Role } from '@/data/experience';
interface Props { role: Role; meta: string; }
const { role, meta } = Astro.props;
---
<article class="role">
  <time class="role__date">{meta}</time>
  <div class="role__body">
    <h3>{role.company}</h3><p class="role__position">{role.position}</p>
    <p class="role__summary">{role.summary}</p>
    <ul>{role.highlights.slice(0, 3).map(item => <li>{item.detail}</li>)}</ul>
    {role.highlights.length > 3 && <details><summary>More about this role</summary><ul>{role.highlights.slice(3).map(item => <li>{item.detail}</li>)}</ul></details>}
    <ul class="role__stack" aria-label="Technologies">{role.stack.map(tool => <li>{tool}</li>)}</ul>
  </div>
</article>
<style>
.role { position:relative; display:grid; grid-template-columns:10rem minmax(0,1fr); gap:var(--space-lg); padding-block:var(--space-lg); border-bottom:1px solid var(--color-rule); }
.role:last-child { border-bottom:0; }
.role__date { position:relative; border-left:1px solid var(--color-rule); padding-left:var(--space-sm); color:var(--color-faint); font-family:var(--font-mono); font-size:.6875rem; line-height:1.7; }
.role__date::before { content:''; position:absolute; width:5px; height:5px; border-radius:50%; left:-3px; top:6px; background:var(--color-accent); }
h3 { font-size:1.25rem; line-height:1.2; }
.role__position { font-size:.8125rem; margin-top:.25rem; }
.role__summary { margin-top:var(--space-sm); color:var(--color-muted); font-size:.875rem; }
.role__body > ul, details ul { padding-left:1rem; margin-top:.75rem; font-size:.875rem; color:var(--color-muted); }
li + li { margin-top:.5rem; }
.role__body > .role__stack { display:flex; flex-wrap:wrap; gap:.35rem; list-style:none; padding:0; margin-top:var(--space-sm); }
.role__stack li { margin:0; background:var(--color-paper-2); padding:.2rem .45rem; font: .6875rem/1.5 var(--font-mono); color:var(--color-muted); }
summary { margin-top:.75rem; font-size:.8125rem; color:var(--color-accent-text); cursor:pointer; }
@media(max-width:40rem) { .role { grid-template-columns:minmax(0,1fr); gap:var(--space-xs); } .role__body { padding-left:var(--space-sm); } }
</style>
