---
import type { Role } from '@/data/experience';
interface Props { role: Role; meta: string; }
const { role, meta } = Astro.props;
---
<article class="role">
  <time class="role__date">{meta}</time>
  <div class="role__body">
    <h3>{role.company}</h3><p class="role__position">{role.position}</p>
    <p class="role__summary">{role.summary}</p>
    <ul>{role.highlights.slice(0, 3).map(item => <li>{item.detail}</li>)}</ul>
    {role.highlights.length > 3 && <details><summary>More about this role</summary><ul>{role.highlights.slice(3).map(item => <li>{item.detail}</li>)}</ul></details>}
    <ul class="role__stack" aria-label="Technologies">{role.stack.map(tool => <li>{tool}</li>)}</ul>
  </div>
</article>
<style>
.role { position:relative; display:grid; grid-template-columns:10rem minmax(0,1fr); gap:var(--space-lg); padding-block:var(--space-lg); border-bottom:2px dashed var(--color-rule); }
.role:last-child { border-bottom:0; }
.role__date { position:relative; border-left:2px solid var(--color-ink); padding-left:var(--space-sm); color:var(--color-ink); font-family:var(--font-hand); font-size:1rem; font-weight:700; line-height:1.4; }
.role__date::before { content:''; position:absolute; width:12px; height:12px; border-radius:50%; left:-7px; top:4px; background:var(--mint); border:2px solid var(--color-ink); }
h3 { font-size:1.5rem; line-height:1.2; }
.role__position { font-size:.875rem; font-weight:600; margin-top:.25rem; }
.role__summary { margin-top:var(--space-sm); color:var(--color-muted); font-size:.875rem; }
.role__body > ul, details ul { padding-left:1rem; margin-top:.75rem; font-size:.875rem; color:var(--color-muted); }
li + li { margin-top:.5rem; }
.role__body > .role__stack { display:flex; flex-wrap:wrap; gap:.35rem; list-style:none; padding:0; margin-top:var(--space-sm); }
.role__stack li { margin:0; background:var(--mint-soft); border:1.5px solid var(--color-ink); border-radius:var(--wobble-pill); padding:.15rem .6rem; font: .6875rem/1.5 var(--font-mono); color:var(--color-muted); }
summary { margin-top:.75rem; font-family:var(--font-hand); font-size:1rem; font-weight:700; color:var(--color-ink); text-decoration:underline wavy var(--color-accent); text-underline-offset:4px; cursor:pointer; }
@media(max-width:40rem) { .role { grid-template-columns:minmax(0,1fr); gap:var(--space-xs); } .role__body { padding-left:var(--space-sm); } }
</style>
