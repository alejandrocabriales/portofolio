---
/**
 * End-of-reading contact line.
 *
 * Someone who reads a case study or a post to the end is the reader most likely
 * to act, and without this the only next step was the nav pill. One sentence
 * and the address itself — the address is the call to action, so it is shown,
 * not hidden behind a "Contact me" button.
 */
import { SITE } from '@/config/site';

interface Props {
  /** The question that frames the contact. One short sentence. */
  line: string;
  /**
   * Sits directly under another ruled block (the post share bar) and shares
   * its bottom rule, instead of drawing two more lines of its own.
   */
  attached?: boolean | undefined;
}

const { line, attached = false } = Astro.props;
---

<aside class:list={['nudge', { 'nudge--attached': attached }]} aria-label="Contact">
  <p class="nudge__line">{line}</p>
  <a class="nudge__cta" href={`mailto:${SITE.email}`}>{SITE.email}</a>
</aside>

<style>
  .nudge {
    margin-block-start: var(--space-2xl);
    padding-block: var(--space-md);
    border-block-start: var(--rule-heavy) solid var(--color-ink);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
  }

  .nudge--attached {
    margin-block-start: 0;
    border-block: 0;
  }

  .nudge__line {
    font-family: var(--font-display);
    font-stretch: var(--stretch-title);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .nudge__cta {
    font-family: var(--font-mono);
    font-stretch: var(--stretch-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }
  .nudge__cta:hover {
    text-decoration-thickness: 2px;
  }
</style>
