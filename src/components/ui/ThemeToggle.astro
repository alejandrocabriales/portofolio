---
/**
 * Colour theme toggle.
 *
 * Three deliberate choices, each fixing a bug in the previous implementation:
 *
 * 1. Icon visibility is driven by CSS descending from `html.dark`, not by JS
 *    adding/removing `.hidden` on load. The old version shipped both icons
 *    hidden and revealed one on `DOMContentLoaded`, so the button rendered
 *    empty until JS parsed.
 *
 * 2. The click handler reads the *DOM* (`classList.toggle` returns the new
 *    state) rather than localStorage. The old version branched on
 *    `localStorage.getItem('theme') === 'dark'`, which is `null` on a first
 *    visit — so a visitor whose OS was dark got a first click that swapped the
 *    icons and changed nothing else. The toggle appeared broken until clicked
 *    twice.
 *
 * 3. The accessible name comes from a visually-hidden label per state.
 *    `display: none` removes the inactive one from the accessibility tree, so
 *    the name is always correct with no JS and no hydration mismatch. The old
 *    button had no label at all — screen readers announced only "button".
 */

interface Props {
  /** Extra classes for positioning within a parent layout. */
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={['theme-toggle', className]}
>
  <span class="theme-toggle__state" data-theme-state="light">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-[18px]"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </svg>
    <span class="sr-only">Switch to dark theme</span>
  </span>

  <span class="theme-toggle__state" data-theme-state="dark">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-[18px]"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
    <span class="sr-only">Switch to light theme</span>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px hit target on coarse pointers, per WCAG AA. */
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--color-muted);
    transition: color var(--dur-micro) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--color-ink);
  }

  /* Exactly one state is in the DOM's accessibility tree at a time. */
  .theme-toggle__state {
    display: none;
  }
  [data-theme-state='light'] {
    display: block;
  }
  :global(.dark) [data-theme-state='light'] {
    display: none;
  }
  :global(.dark) [data-theme-state='dark'] {
    display: block;
  }
</style>

<script>
  // Delegated from `document` so the handler survives DOM swaps (View
  // Transitions) without rebinding, and works for any number of toggles.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('[data-theme-toggle]')) return;

    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      // Storage unavailable — the toggle still works for this page view.
    }
  });

  // Follow the OS only while the visitor has not made an explicit choice.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      /* ignore */
    }
    if (stored) return;
    document.documentElement.classList.toggle('dark', event.matches);
  });

  // Re-assert after a View Transition swap, for when ClientRouter is added.
  document.addEventListener('astro:after-swap', () => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      /* ignore */
    }
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', stored === 'dark' || (!stored && prefersDark));
  });
</script>
