  "narrative": {
    "northStar": "The Engineer's Ledger",
    "overview": "The site reads like a well-kept ledger: ruled lines, mono figures in a right-hand column, and entries that state what happened and what it measured. It is a narrow, single-column reading surface (46rem) on warm off-white paper, where structure comes from hairlines and type rather than boxes and colour. Every section opens with a mono uppercase label sitting on a full-ink rule; rows below it are separated by quieter hairlines.\n\nThree voices share the page and never swap jobs. Space Grotesk makes claims (the headline, names of things). Newsreader explains (summaries, case-study prose, posts). JetBrains Mono records facts (dates, years, clients, stacks, labels). One warm amber accent marks the single thing that matters in a region: the measured outcome, the current nav destination, the hovered link.\n\nMotion is a single page-load stagger and small, state-driven hover changes. No lift, no scale, no shadow.",
    "keyCharacteristics": [
      "Warm-tinted neutrals on hue ~60; never pure white or black.",
      "Ink rules open sections; light rules separate rows.",
      "Mono for data only, serif for reading, grotesk for naming.",
      "One amber accent, used sparingly and with one meaning per region.",
      "Flat surfaces; depth by tone and rules, not shadow."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Amber marks one thing per region. If two amber elements compete in the same view, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Fills-Not-Text Rule",
        "body": "`amber` is a fill colour; any amber text uses `amber-text`.",
        "section": "colors"
      },
      {
        "name": "The Faint Floor Rule",
        "body": "`faint` is the lowest step allowed to carry text, and it must stay ≥4.5:1 on paper and paper-2. Nothing quieter than `faint` carries words.",
        "section": "colors"
      },
      {
        "name": "The Roman Headings Rule",
        "body": "Headings are never italic; italic belongs to body copy and blockquotes.",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "Metadata (client, date, reading time) sits under the title it qualifies, never as an eyebrow above it. Section labels are themselves the `h2`, not decoration over one.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any date, year or figure that can line up with another uses tabular lining numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Hover changes colour or border, never elevation. No lift, no scale, no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every colour from the tokens; light and dark are one palette at hue ~60.",
      "Do keep text at `faint` or stronger, with ≥4.5:1 contrast on its surface in both themes.",
      "Do put client, date and reading time under the title as mono meta.",
      "Do use tabular lining numerals for dates, years and figures.",
      "Do give every link a visible hover state and keep the 2px focus outline instant (never transitioned).",
      "Do collapse rows to one column below 40rem with meta first."
    ],
    "donts": [
      "Don't add box shadows, lift or scale on hover.",
      "Don't use amber for more than one thing in the same region, or `amber` (not `amber-text`) for text.",
      "Don't put an eyebrow or kicker above a heading.",
      "Don't render stacks as rows of rounded pill tags; they are mono text.",
      "Don't use pure white or pure black surfaces.",
      "Don't set text below 0.6875rem.",
      "Don't use italic headings."
    ]
  }
